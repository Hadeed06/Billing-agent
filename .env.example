
# =========================
# Public URLs (required)
# =========================
# Your public https base (e.g., ngrok, Cloudflare Tunnel, or prod domain)
# Example: https://abcd-12-34-56-78.ngrok-free.app
WEBHOOK_BASE_URL=https://REPLACE_WITH_PUBLIC_BASE

# =========================
# Telnyx (required)
# =========================
TELNYX_API_KEY=REPLACE_ME
TEL_FROM=+1800.....    # Your Telnyx number in E.164
TEL_TO=+1855.....      # The destination number in E.164   
CALL_CONTROL_APP_ID=REPLACE_ME              # Your Telnyx Call Control App ID

# =========================
# Azure Speech (required)
# =========================
AZURE_SPEECH_KEY=REPLACE_ME
AZURE_SPEECH_REGION=centralus               # e.g., eastus, centralus, westeurope
AZURE_SPEECH_ENDPOINT=https-Replace_me

# =========================
# LLMs
# =========================
# Local Llama endpoint used by services/llm_service.py
LLM_URL=http://1-REPLACE_ME:8080

# OpenAI (used by the claims controller keyword-decider)
OPENAI_API_KEY=sk-REPLACE_ME

# =========================
# Insurance selection
# =========================
# No env var — the insurance is chosen per-call by the payer_id sent in the
# /v1/Billing-Agent/Call request body. Supported payer IDs:
#   61101 → HUMANA
#   62308 → CIGNA
#   94999 → BAYLOR_SCOTT
#   OSCAR → OSCAR

# =========================
# JWT Authentication
# =========================
JWT_SECRET_KEY=REPLACE_ME

# =========================
# PracticeEHR Upload
# =========================
PRACTICE_EHR_BASE_URL=REPLACE_ME
PRACTICE_EHR_STORAGE_ACCOUNT=stblobaiscribeqawu2
PRACTICE_EHR_CONTAINER=documents

# =========================
# Billing-Agent Log Endpoint
# =========================
BILLING_AGENT_LOG_BASE_URL=REPLACE_ME

# =========================
# Clinical API (visit data lookup before each call)
# =========================
CLINICAL_API_BASE_URL=REPLACE_ME

# =========================
# PracticeEHR Auth (per-customer API key resolver)
# =========================
# API key for Clinical + Billing-Agent/Log is resolved at call start by
# POST {PRACTICE_EHR_AUTH_BASE_URL}/v1/Clients/AuthClients using the
# customer_id + Bearer token.
PRACTICE_EHR_AUTH_BASE_URL=REPLACE_ME

# =========================
# IVR/ClaimStatus Endpoint
# =========================
# Final per-call status update, sent after Billing-Agent/Log returns its row id.
IVR_CLAIM_STATUS_BASE_URL=REPLACE_ME
APP_VERSION=1.0